{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadml.dev/schema/cadml.schema.json",
  "title": "CADML Normalized Document",
  "type": "object",
  "$defs": {
    "unit": {
      "type": "string",
      "enum": [
        "mm",
        "cm",
        "m",
        "in",
        "ft",
        "deg",
        "rad"
      ]
    },
    "valueWithUnit": {
      "type": "object",
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/unit"
        }
      }
    },
    "scalarOrUnitValue": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/valueWithUnit"
        }
      ]
    },
    "paramMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/scalarOrUnitValue"
      }
    }
  },
  "required": [
    "version",
    "kind",
    "name",
    "objects"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Schema version in semver format, e.g. 1.0.0"
    },
    "kind": {
      "type": "string",
      "const": "assembly"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "properties"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "wall",
              "beam",
              "shaft",
              "gear",
              "bolt",
              "plate",
              "pipe",
              "bracket",
              "joint"
            ]
          },
          "name": {
            "type": "string"
          },
          "properties": {
            "type": "object",
            "description": "Semantic object attributes (dimensions, material, and domain properties)",
            "additionalProperties": {
              "$ref": "#/$defs/scalarOrUnitValue"
            }
          },
          "relationships": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "target"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                },
                "params": {
                  "$ref": "#/$defs/paramMap"
                }
              }
            }
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "description": "Target object or selector within assembly scope"
          },
          "params": {
            "$ref": "#/$defs/paramMap"
          }
        }
      }
    }
  }
}
