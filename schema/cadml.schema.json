{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadml.dev/schema/cadml.schema.json",
  "title": "CADML Document",
  "type": "object",
  "required": [
    "version",
    "kind",
    "name",
    "objects"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Schema version in semver format, e.g. 1.0.0"
    },
    "kind": {
      "type": "string",
      "const": "assembly"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "properties"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "wall",
              "beam",
              "shaft",
              "gear",
              "bolt",
              "plate",
              "pipe",
              "bracket",
              "joint"
            ]
          },
          "name": {
            "type": "string"
          },
          "properties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "object",
                  "required": [
                    "value",
                    "unit"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "value": {
                      "type": "number"
                    },
                    "unit": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            }
          },
          "relationships": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "description": "Target object or selector within assembly scope"
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "object",
                  "required": [
                    "value",
                    "unit"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "value": {
                      "type": "number"
                    },
                    "unit": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
